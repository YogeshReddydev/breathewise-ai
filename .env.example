# =================================================================
# BreatheWise AI - Environment Configuration Template
# Copy this file to .env and configure your secrets securely.
# =================================================================

# Server Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Google Gemini API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Air Quality Providers
# Open-Meteo Air Quality requires NO key and provides live, high-resolution global atmospheric data.
DEFAULT_AQI_PROVIDER=open_meteo
AQI_CACHE_TTL_SECONDS=900

# Optional: WAQI API Key (if you wish to enable the WAQI secondary provider)
WAQI_API_TOKEN=

# Safety & Rate Limits
MAX_CONSULTATION_HISTORY=10
RATE_LIMIT_PER_MINUTE=60
