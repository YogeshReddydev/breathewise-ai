# ==============================================================================
# BreatheWise AI - Environment Configuration Example
# Copy to .env in backend/ or root for local configuration.
# NEVER commit real API keys or secrets to git.
# ==============================================================================

# Backend Settings
APP_NAME="BreatheWise AI"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Google Gemini API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
# Leave empty to automatically use BreatheWise's expert rule-based environmental reasoning engine.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# AQI Data Providers
# Primary provider: open-meteo (Free, no API key needed, real global live AQI data)
DEFAULT_AQI_PROVIDER="open-meteo"

# Optional Secondary Providers
# World Air Quality Index (WAQI / aqicn.org) API Token
WAQI_API_KEY=""

# OpenAQ API Key (optional)
OPENAQ_API_KEY=""

# Cache TTL in seconds for AQI responses to respect rate limits
AQI_CACHE_TTL_SECONDS=900

# Frontend Settings (Vite)
VITE_API_BASE_URL="http://localhost:8000/api"
