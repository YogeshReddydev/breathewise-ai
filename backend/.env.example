# BreatheWise AI Backend Environment Variables
APP_NAME="BreatheWise AI Backend"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Google Gemini API Key
# Optional: If not provided, BreatheWise uses its deterministic EPA/WHO expert rule engine
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# AQI Data Providers
DEFAULT_AQI_PROVIDER="open-meteo"
WAQI_API_KEY=""
OPENAQ_API_KEY=""
AQI_CACHE_TTL_SECONDS=900
